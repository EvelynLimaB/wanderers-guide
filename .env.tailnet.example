# Wanderer's Guide .env values for a Tailscale Serve deployment.
#
# Copy the parts you need into your .env (do NOT commit real secrets).
# Everything here assumes the site is published at:
#     https://pc-eve.tail1a585f.ts.net
# Replace that with your own `tailscale serve status` hostname.

# ---- THE ONE THAT BREAKS EVERYTHING IF YOU GET IT WRONG ---------------------
# Baked into the Vite bundle at BUILD time, and used by the browser to reach
# the API. With frontend/nginx.conf proxying /auth/v1, /rest/v1, /storage/v1,
# /functions/v1 to kong, this is just the site origin: no port, no /api suffix,
# no trailing slash.
#
#   WRONG: http://localhost:8000   -> every API call goes to the *viewer's* own
#                                     machine. Page loads, then nothing works.
PUBLIC_SUPABASE_URL=https://pc-eve.tail1a585f.ts.net

# ---- host ports / bind addresses -------------------------------------------
# Rootless Podman cannot publish ports < 1024, so nothing here may be 80/443.
# Tailscale Serve does the 443 termination and proxies to localhost:8080.
FRONTEND_PORT=8080
FRONTEND_BIND=127.0.0.1
KONG_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1

# ---- auth redirects ---------------------------------------------------------
# Where GoTrue sends users after signup / password reset / OAuth.
SITE_URL=https://pc-eve.tail1a585f.ts.net
ADDITIONAL_REDIRECT_URLS=https://pc-eve.tail1a585f.ts.net/**

# ---- secrets: REGENERATE, do not reuse the repo defaults --------------------
# .env.docker.example ships a well-known JWT_SECRET + ANON_KEY pair that is
# public on GitHub. Generate your own:
#   openssl rand -hex 32                       -> JWT_SECRET
#   then sign anon / service_role JWTs with it:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=

# ---- frontend build ---------------------------------------------------------
VITE_ENV=production

# ---- studio (opt-in: podman-compose --profile studio up -d) -----------------
STUDIO_PORT=54323
DEFAULT_ORG_NAME=Default
DEFAULT_PROJECT_NAME=Wanderer's Guide

CONTENT_UPDATE_KEY=
