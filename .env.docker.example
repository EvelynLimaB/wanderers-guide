# Supabase API endpoint reachable by the browser.
# External/Tailscale deployments should point this at the existing Supabase instance.
PUBLIC_SUPABASE_URL=https://your-supabase-host.example

# Public browser API key for that Supabase project.
ANON_KEY=replace-with-your-anon-key

# Frontend
FRONTEND_PORT=3000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
VITE_ENV=production

# The following values are only needed when using
# `docker compose --profile self-hosted ...`.
JWT_SECRET=replace-me-with-a-strong-secret
SERVICE_ROLE_KEY=replace-with-your-service-role-key
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_PORT=54322
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Auth (self-hosted)
JWT_EXPIRY=3600
EMAIL_AUTOCONFIRM=true

# Studio (self-hosted, opt-in)
STUDIO_PORT=54323
DEFAULT_ORG_NAME=Default
DEFAULT_PROJECT_NAME=Wanderer's Guide

# Shared secret for the content-updates Discord bot webhook (self-hosted functions)
CONTENT_UPDATE_KEY=pick-any-shared-secret
